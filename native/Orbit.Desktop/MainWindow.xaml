<Window x:Class="Orbit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orbit · Native preview" Width="1240" Height="820" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101619" BorderBrush="#242D29" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,28,14,20">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="⬡ Orbit" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Mint}" Margin="8,0,0,4"/><TextBlock Text="C# NATIVE PREVIEW" FontSize="10" Foreground="#68736F" Margin="10,0,0,30"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Button Content="Settings" Click="SettingsClick"/><TextBlock Text="Free · Windows workspace" Foreground="#68736F" FontSize="10" Margin="8,14,0,0"/></StackPanel>
        <StackPanel><Button Content="Accounts" Click="AccountsClick"/><Button Content="Roblox launcher" Click="LauncherClick"/><Button Content="Live view" Click="LiveClick"/><Button Content="Layouts" Click="LayoutsClick"/><Button Content="Audio" Click="AudioClick"/><Button Content="Activity" Click="ActivityClick"/><Button Content="Migration status" Click="MigrationClick"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,22"><TextBlock x:Name="PageTitle" Text="Accounts" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Every account. In your orbit." Foreground="#9DA8A5" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
      <ContentControl x:Name="Page" Grid.Row="1"/>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready" Foreground="#9DA8A5" TextWrapping="Wrap"/><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel operation" Click="CancelClick" Visibility="Collapsed" Padding="12,5"/></Grid>
    </Grid>
  </Grid>
</Window>
